   "locked": false,
   "text": "obs = reset(scenario_id, mode, half)\nwhile not obs.done:\n    reply = policy(history)\n    obs = step(reply)\n    if the patient answered:\n        history += the patient's turn\nrecord = score, per-axis scores, verdicts,\n    judge cost, turns, policy / env timings\nreturn {\"env\": record}  -> sample.metadata",
   "originalText": "obs = reset(scenario_id, mode, half)\nwhile not obs.done:\n    reply = policy(history)\n    obs = step(reply)\n    if the patient answered:\n        history += the patient's turn\nrecord = score, per-axis scores, verdicts,\n    judge cost, turns, policy / env timings\nreturn {\"env\": record}  -> sample.metadata",
