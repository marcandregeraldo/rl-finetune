   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1. ray start --head  :6379, dashboard :8265\n2. wait until 16 GPUs joined (180 s)\n3. submit a Ray Job:\n     python -m nanorft.driver \\\n        --config /runs/<run_id>/config.yaml\n4. tail the job logs -> Modal logs\n5. fail the call unless SUCCEEDED\n6. ray stop, commit /runs",
   "originalText": "1. ray start --head  :6379, dashboard :8265\n2. wait until 16 GPUs joined (180 s)\n3. submit a Ray Job:\n     python -m nanorft.driver \\\n        --config /runs/<run_id>/config.yaml\n4. tail the job logs -> Modal logs\n5. fail the call unless SUCCEEDED\n6. ray stop, commit /runs",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
